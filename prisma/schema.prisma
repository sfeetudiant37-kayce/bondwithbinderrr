generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  password        String
  phone           String?
  location        String
  language        String   @default("en")
  activeRole      String   @default("client")
  profileCompletion Int    @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile         Profile?
  swipesGiven     Swipe[]           @relation("SwiperUser")
  matchesAsClient Match[]           @relation("ClientUser")
  matchesAsProvider Match[]         @relation("ProviderUser")
  requestsPosted  ServiceRequest[]
  messagesSent     Message[]
  reviewsGiven    Review[]          @relation("Reviewer")
  reviewsReceived Review[]          @relation("Reviewee")
  weights         WeightConfig?
  notifications   Notification[]
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  photoUrl        String?
  bio             String?
  price           Float?
  availability    String   @default("immediate")
  experience      Int      @default(0)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  skills          String
  preferences     String
  objective       String
  socialLinks     String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceRequest {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  description String
  category    String
  location    String
  budget      Float
  urgency     String   @default("flexible")
  skills      String
  status      String   @default("open")
  createdAt   DateTime @default(now())

  client      User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  swipes      Swipe[]
  matches     Match[]
}

model Swipe {
  id              String   @id @default(cuid())
  swiperId        String
  targetUserId    String?
  targetRequestId String?
  swiperRole      String
  direction       String
  fitScore        Int
  createdAt       DateTime @default(now())

  swiper          User            @relation("SwiperUser", fields: [swiperId], references: [id], onDelete: Cascade)
  targetRequest   ServiceRequest? @relation(fields: [targetRequestId], references: [id])
}

model Match {
  id              String   @id @default(cuid())
  clientId        String
  providerId      String
  requestId       String?
  initiatedBy     String
  clientFitScore  Int
  providerFitScore Int?
  status          String   @default("provider_interested")
  contactRevealed Boolean  @default(true)
  createdAt       DateTime @default(now())

  client          User            @relation("ClientUser", fields: [clientId], references: [id])
  provider        User            @relation("ProviderUser", fields: [providerId], references: [id])
  request         ServiceRequest? @relation(fields: [requestId], references: [id])
  conversation   Conversation?
  reviews        Review[]
}

model Conversation {
  id            String   @id @default(cuid())
  matchId       String   @unique
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages      Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  sentAt         DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  matchId   String
  reviewerId String
  revieweeId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  match     Match    @relation(fields: [matchId], references: [id])
  reviewer  User     @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee  User     @relation("Reviewee", fields: [revieweeId], references: [id])
}

model WeightConfig {
  id                 String   @id @default(cuid())
  userId             String   @unique
  preferences        Float    @default(0.20)
  location           Float    @default(0.15)
  price              Float    @default(0.15)
  rating             Float    @default(0.15)
  availability       Float    @default(0.10)
  profileCompleteness Float   @default(0.10)
  experience         Float    @default(0.15)
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String
  isRead     Boolean  @default(false)
  referenceId String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
